{
  "name": "whoop-desk",
  "productName": "Whoop+",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "ipc-check": "electron . --ipc-check",
    "build:native": "swiftc -O -o native/bin/hr-bridge native/hr-bridge.swift",
    "build:app": "npm run build:native && npx @electron/packager . 'Whoop+' --platform=darwin --arch=arm64 --out=dist --overwrite --no-asar --extend-info=assets/extend-info.plist --extra-resource=native/bin/hr-bridge"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0"
  }
}
